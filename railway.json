{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "relay/Dockerfile",
    "watchPatterns": ["/relay/**", "/railway.json", "/.dockerignore"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": "/health"
  }
}
