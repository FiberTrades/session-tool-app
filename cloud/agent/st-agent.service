[Unit]
Description=Session Terminal cloud MT5 agent (runs members' MT5 + EA, see cloud/agent/st_agent.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/st/st_agent.py
Restart=always
RestartSec=10
# MT5 processes started by the agent live on after a restart of the agent itself
KillMode=process

[Install]
WantedBy=multi-user.target
