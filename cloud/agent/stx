#!/bin/bash
# stx <login> <xdotool args...>  /  stx <login> shot <file.png> : act on (or screenshot) that account's MT5 screen
L=$1; shift
PID=$(pgrep -u st -f "ST/$L/terminal64.exe" | head -1)
XV=$(ps -u st -o args= | grep -m1 "^Xvfb :" )
# the Xvfb that belongs to this terminal: xvfb-run parent of the wine process
XR=$(pgrep -u st -f "xvfb-run.*ST/$L/terminal64.exe" | head -1)
XVPID=$(pgrep -u st -P $XR Xvfb | head -1)
ARGS=$(ps -o args= -p $XVPID)
D=$(echo "$ARGS" | grep -o ":[0-9]*" | head -1)
XA=$(echo "$ARGS" | grep -o "\-auth [^ ]*" | cut -d" " -f2)
if [ "$1" = "shot" ]; then su st -c "DISPLAY=$D XAUTHORITY=$XA xwd -root -silent" > /tmp/stx.xwd && convert /tmp/stx.xwd "$2"; exit; fi
su st -c "DISPLAY=$D XAUTHORITY=$XA xdotool $*"
