[Unit]
Description=Session Terminal live relay (relay/server.py) - EAs and app windows, behind Caddy at live.sessionterminal.com
After=network-online.target
Wants=network-online.target

[Service]
Environment=HOST=127.0.0.1 PORT=8080 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/st/relay/server.py
DynamicUser=yes
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
