# Session Terminal's own server (uk1): the live relay at live.sessionterminal.com. Caddy fetches and renews the certificate
# itself (MT5 only connects to an address with a valid one) and passes the WebSockets to the relay on 127.0.0.1:8080.
live.sessionterminal.com {
	reverse_proxy 127.0.0.1:8080
}
